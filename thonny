# =========================================================
# DETEKTOR TANGAN (Anti-Noise & Debounce)
# =========================================================

BATAS_JARAK = 15      # cm
HYSTERESIS = 4        # cm
KONFIRMASI = 2        # kali bacaan berturut-turut

class DetektorTangan:
    def __init__(self):
        self.aktif = False
        self.dekat = 0
        self.jauh = 0

    def update(self, jarak):
        if jarak < BATAS_JARAK:
            self.dekat += 1
            self.jauh = 0
            if self.dekat >= KONFIRMASI and not self.aktif:
                self.aktif = True
                return True
        elif jarak > BATAS_JARAK + HYSTERESIS:
            self.jauh += 1
            self.dekat = 0
            if self.jauh >= KONFIRMASI:
                self.aktif = False
        return False


