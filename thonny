    print(" - Aplikasi Flutter : Future Speaker siap!")
    print("========================================")
    print("LAGU AWAL:", nama_lagu[lagu_sekarang])
    print()

    while True:
        now = time.ticks_ms()

        # 1. Update nada speaker
        update_music()

        # 2. Cek perintah dari Aplikasi Flutter via WiFi
        check_wifi_requests()

        # 3. Baca sensor HC-SR04 bergantian
        if time.ticks_diff(now, waktu_ukur_berikut) >= 0:
            waktu_ukur_berikut = time.ticks_add(now, INTERVAL_UKUR)

            if giliran == 0:
                sensor_kiri_dist = sensor_kiri.get_distance()
                if tangan_kiri.update(sensor_kiri_dist):
                    print("GESTURE KIRI -> PREV SONG")
                    previous_song()
            else:
                sensor_kanan_dist = sensor_kanan.get_distance()
                if tangan_kanan.update(sensor_kanan_dist):
                    tap_kanan += 1
                    waktu_tap_kanan = now
                    print("GESTURE KANAN TAP:", tap_kanan)

            giliran = 1 - giliran

        # 4. Deteksi Tap Tunggal atau Ganda pada Sensor Kanan
        if tap_kanan > 0:
            if time.ticks_diff(now, waktu_tap_kanan) > DOUBLE_TAP_TIME:
                if tap_kanan == 1:
                    print("GESTURE KANAN 1x -> PLAY / PAUSE")
                    toggle_play()
                else:
                    print("GESTURE KANAN 2x -> NEXT SONG")
                    next_song()
                tap_kanan = 0

        time.sleep_ms(1)

except KeyboardInterrupt:
