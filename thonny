# =========================================================
# STATE MUSIK
# =========================================================

lagu_sekarang = 0
note_index = 0
note_end = 0
playing = True


def start_note():
    global note_index, note_end
    lagu = playlist[lagu_sekarang]

    if note_index >= len(lagu):
        note_index = 0

    freq, dur = lagu[note_index]
    if freq == REST:
        speaker.duty(0)
    else:
        speaker.freq(freq)
        speaker.duty(VOLUME)

    note_end = time.ticks_add(time.ticks_ms(), dur)


def update_music():
    global note_index
    if not playing:
        speaker.duty(0)
        return

    now = time.ticks_ms()
    if time.ticks_diff(now, note_end) >= 0:
        speaker.duty(0)
        note_index += 1
        if note_index >= len(playlist[lagu_sekarang]):
            note_index = 0
        start_note()


def toggle_play():
    global playing
    if playing:
        playing = False
        speaker.duty(0)
        print(">>> PAUSE <<<")
    else:
        playing = True
        print(">>> PLAY:", nama_lagu[lagu_sekarang])
        start_note()


def next_song():
    global lagu_sekarang, note_index, note_end
    speaker.duty(0)
    lagu_sekarang = (lagu_sekarang + 1) % len(playlist)
    note_index = 0
    note_end = 0
    print(">>> NEXT:", nama_lagu[lagu_sekarang])
    if playing:
        start_note()


def previous_song():
    global lagu_sekarang, note_index, note_end
    speaker.duty(0)
    lagu_sekarang = (lagu_sekarang - 1 + len(playlist)) % len(playlist)
    note_index = 0
    note_end = 0
    print(">>> PREV:", nama_lagu[lagu_sekarang])
    if playing:
        start_note()


def select_song(index):
    global lagu_sekarang, note_index, note_end
    if 0 <= index < len(playlist):
        speaker.duty(0)
        lagu_sekarang = index
        note_index = 0
        note_end = 0
        print(">>> SELECT:", nama_lagu[lagu_sekarang])
        if playing:
            start_note()


# =========================================================
# WI-FI & WEB SERVER (Aman dari bentrok port / EADDRINUSE)
# =========================================================

server_ip = "192.168.4.1"
server_socket = None

def setup_wifi():
    global server_ip
    # 1. Hubungkan ke router jika diisi
    if WIFI_SSID:
        try:
            print("Menghubungkan ke Wi-Fi:", WIFI_SSID)
            sta = network.WLAN(network.STA_IF)
            sta.active(True)
            sta.connect(WIFI_SSID, WIFI_PASS)
            for _ in range(25):
                if sta.isconnected():
                    server_ip = sta.ifconfig()[0]
                    print("Wi-Fi Terhubung! IP:", server_ip)
                    return
                time.sleep_ms(200)
            print("Gagal tersambung ke router. Mengaktifkan Mode AP...")
        except Exception as e:
            print("Wi-Fi STA error:", e)

    # 2. Mode Access Point (Hotspot ESP)
    try:
        ap = network.WLAN(network.AP_IF)
        ap.active(True)
        try:
            ap.config(essid=AP_SSID, authmode=network.AUTH_WPA_WPA2_PSK, password=AP_PASS)
        except Exception:
            try:
                ap.config(essid=AP_SSID, password=AP_PASS)
            except Exception:
                ap.config(essid=AP_SSID)
        server_ip = ap.ifconfig()[0]
    except Exception as e:
        print("AP config warning:", e)

    print("----------------------------------------")
    print("Hotspot ESP Aktif!")
    print("SSID:", AP_SSID, "| Sandi:", AP_PASS)
    print("IP Speaker:", server_ip)
    print("----------------------------------------")


def init_socket_server():
    global server_socket
    gc.collect()

    for attempt in range(3):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(('', 80))
            s.listen(2)
            s.setblocking(False)
            server_socket = s
            print("Web Server aktif di port 80.")
            return
        except Exception as err:
            print("Menunggu port 80 dilepas...", err)
            try:
                s.close()
            except:
                pass
            time.sleep_ms(400)

    print("Peringatan: Gagal bind port 80. Fitur gesture tetap berjalan!")


# Jalankan konfigurasi Wi-Fi & Server
try:
    setup_wifi()
    init_socket_server()
except Exception as e:
    print("Init WiFi/Server error:", e)


def send_json(conn, data_str):
    header = (
        "HTTP/1.1 200 OK\r\n"
        "Content-Type: application/json\r\n"
        "Access-Control-Allow-Origin: *\r\n"
        "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
        "Access-Control-Allow-Headers: *\r\n"
        "Connection: close\r\n\r\n"
    )
    conn.sendall(header + data_str)


def check_wifi_requests():
    global playing
    if server_socket is None:
        return

    try:
        conn, addr = server_socket.accept()
    except Exception:
        return  # Tidak ada request yang masuk

    try:
        conn.settimeout(0.04)
        raw = conn.recv(512)
        if not raw:
            conn.close()
            return

        req = raw.decode('utf-8', 'ignore')
        first_line = req.split('\r\n')[0]
        parts = first_line.split()

        if len(parts) >= 2:
            method, path = parts[0], parts[1]

            if method == "OPTIONS":
                send_json(conn, '{"status":"ok"}')
                conn.close()
                return

            if "/api/toggle" in path:
                toggle_play()
            elif "/api/play" in path:
                if not playing:
                    toggle_play()
            elif "/api/pause" in path:
                if playing:
                    toggle_play()
            elif "/api/next" in path:
                next_song()
            elif "/api/prev" in path:
                previous_song()
            elif "/api/select" in path:
                try:
                    song_id = int(path.split("id=")[1].split("&")[0])
                    select_song(song_id)
                except:
                    pass
            elif "/api/restart" in path:
                speaker.duty(0)
                select_song(0)

            resp = '{"device":"Future Speaker","playing":%s,"song_index":%d,"song_name":"%s","kiri":%.1f,"kanan":%.1f}' % (
                "true" if playing else "false",
                lagu_sekarang,
                nama_lagu[lagu_sekarang],
                sensor_kiri_dist,
                sensor_kanan_dist
            )
            send_json(conn, resp)
    except Exception:
        pass
    finally:
        try:
            conn.close()
        except Exception:
            pass


