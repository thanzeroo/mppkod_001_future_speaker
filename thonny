# =========================================================
# HC-SR04 SENSOR ULTRASONIK
# =========================================================

class HCSR04:
    def __init__(self, trig_pin, echo_pin):
        self.trig = machine.Pin(trig_pin, machine.Pin.OUT)
        self.echo = machine.Pin(echo_pin, machine.Pin.IN)
        self.trig.value(0)

    def get_distance(self):
        self.trig.value(0)
        time.sleep_us(5)
        self.trig.value(1)
        time.sleep_us(10)
        self.trig.value(0)

        try:
            pulse = machine.time_pulse_us(self.echo, 1, 6000)
            if pulse < 0:
                return 999.0
            return (pulse * 0.0343) / 2
        except Exception:
            return 999.0


